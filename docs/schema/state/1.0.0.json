{
  "$id": "https://schemas.noesis.dev/state/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$schema_name": "state",
  "$schema_version": "1.0.0",
  "additionalProperties": false,
  "description": "Snapshot of the orchestration inputs, evolving plan, beliefs, memory, and tool outcomes that drive a run. Provides richer reconstruction context than summary.json and is the source of truth for plan adherence.",
  "properties": {
    "beliefs": {
      "description": "Optional structured beliefs derived while interpreting evidence.",
      "items": {
        "properties": {
          "confidence": {
            "maximum": 1,
            "minimum": 0,
            "type": "number",
            "x-stability": "beta"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "x-stability": "experimental"
          },
          "statement": {
            "type": "string",
            "x-stability": "beta"
          }
        },
        "required": [
          "statement",
          "confidence"
        ],
        "type": "object"
      },
      "type": "array",
      "x-stability": "experimental"
    },
    "episode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "ULID shared across all artifacts in the run folder.",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "type": "string",
          "x-stability": "stable"
        },
        "label": {
          "description": "Human-friendly folder label (e.g., runs/demo).",
          "type": "string",
          "x-stability": "beta"
        },
        "seed": {
          "description": "RNG seed.",
          "minimum": 0,
          "type": "integer",
          "x-stability": "stable"
        },
        "tags": {
          "additionalProperties": {
            "type": [
              "string",
              "boolean",
              "number"
            ]
          },
          "description": "Arbitrary metadata for downstream filters.",
          "type": "object",
          "x-stability": "beta"
        },
        "using": {
          "description": "Identifier of the orchestration preset/graph.",
          "type": "string",
          "x-stability": "stable"
        }
      },
      "required": [
        "id",
        "label",
        "using",
        "seed"
      ],
      "type": "object",
      "x-stability": "stable"
    },
    "goal": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "description": "Supplemental context appended to the task.",
          "type": "string",
          "x-stability": "experimental"
        },
        "task": {
          "description": "Original instruction provided to the run.",
          "type": "string",
          "x-stability": "stable"
        }
      },
      "type": "object",
      "x-stability": "beta"
    },
    "links": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "type": "string",
          "x-stability": "stable"
        },
        "learn": {
          "type": "string",
          "x-stability": "beta"
        },
        "state": {
          "type": "string",
          "x-stability": "stable"
        },
        "summary": {
          "type": "string",
          "x-stability": "stable"
        }
      },
      "required": [
        "events",
        "summary",
        "state"
      ],
      "type": "object",
      "x-stability": "stable"
    },
    "memory": {
      "additionalProperties": true,
      "description": "Facts promoted to long-term memory plus scratchpad content.",
      "type": "object",
      "x-stability": "experimental"
    },
    "outcomes": {
      "additionalProperties": false,
      "description": "Final action traces and reviewer-facing verdicts.",
      "properties": {
        "actions": {
          "items": {
            "properties": {
              "artifacts": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "x-stability": "beta"
              },
              "result_status": {
                "enum": [
                  "ok",
                  "error",
                  "blocked"
                ],
                "type": "string",
                "x-stability": "stable"
              },
              "tool": {
                "type": "string",
                "x-stability": "beta"
              }
            },
            "required": [
              "tool",
              "result_status"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "scorecard": {
          "additionalProperties": true,
          "type": "object",
          "x-stability": "experimental"
        }
      },
      "type": "object",
      "x-stability": "beta"
    },
    "plan": {
      "additionalProperties": false,
      "description": "Planner graph plus ordered steps executed by Direction.",
      "properties": {
        "adherence_window": {
          "description": "Step count used when calculating plan adherence.",
          "minimum": 1,
          "type": "integer",
          "x-stability": "beta"
        },
        "steps": {
          "items": {
            "properties": {
              "depends_on": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "x-stability": "beta"
              },
              "id": {
                "type": "string",
                "x-stability": "stable"
              },
              "kind": {
                "enum": [
                  "think",
                  "act",
                  "reflect"
                ],
                "type": "string",
                "x-stability": "stable"
              },
              "status": {
                "enum": [
                  "pending",
                  "in_progress",
                  "done",
                  "skipped",
                  "blocked"
                ],
                "type": "string",
                "x-stability": "stable"
              },
              "summary": {
                "type": "string",
                "x-stability": "stable"
              },
              "tool": {
                "description": "Tool invoked when kind == \"act\".",
                "type": "string",
                "x-stability": "beta"
              }
            },
            "required": [
              "id",
              "kind",
              "status",
              "summary"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array",
          "x-stability": "stable"
        }
      },
      "required": [
        "steps"
      ],
      "type": "object",
      "x-stability": "stable"
    },
    "schema_version": {
      "description": "Semver string for the state schema revision.",
      "enum": [
        "1.0.0"
      ],
      "type": "string",
      "x-stability": "stable"
    }
  },
  "required": [
    "schema_version",
    "episode",
    "plan",
    "links"
  ],
  "title": "Noēsis State Artifact",
  "type": "object",
  "x-owners": [
    "Core Engineering"
  ],
  "x-stability": "stable"
}
