{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NoesisGovernanceResult",
  "type": "object",
  "required": [
    "schema_version",
    "decision_id",
    "decision",
    "rule_id",
    "score",
    "message",
    "policy_id",
    "policy_version",
    "policy_kind",
    "governance_id",
    "enforced",
    "mode",
    "failure_policy"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "governance_id": {
      "type": "string"
    },
    "decision_id": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": ["allow", "audit", "veto"]
    },
    "rule_id": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "message": {
      "type": "string"
    },
    "policy_id": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "policy_kind": {
      "type": "string",
      "enum": ["llm", "rules", "hybrid"]
    },
    "mode": {
      "type": "string",
      "enum": ["off", "audit", "enforce"]
    },
    "failure_policy": {
      "type": "string",
      "enum": ["fail_open", "fail_closed"]
    },
    "enforced": {
      "type": "boolean"
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "details": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "suggested_fixes": {
      "type": ["array", "null"],
      "items": {
        "type": "object"
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
