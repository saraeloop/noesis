{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NoesisIntuitionEvent",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "advice",
    "confidence",
    "policy_id",
    "policy_version",
    "policy_kind",
    "applied",
    "target",
    "scope",
    "blocking",
    "evidence_ids"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "advice": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "policy_id": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "policy_kind": {
      "type": "string",
      "enum": ["llm", "rules", "hybrid"]
    },
    "applied": {
      "type": "boolean"
    },
    "rationale": {
      "type": ["string", "null"]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "patch": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "target": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "blocking": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
