{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NoesisPlannerDirective",
  "type": "object",
  "required": [
    "schema_version",
    "directive_id",
    "steps",
    "status",
    "reason",
    "diff",
    "applied",
    "policy_id",
    "policy_version",
    "policy_kind",
    "legacy_directive_id"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "directive_id": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": ["applied", "skipped", "blocked"]
    },
    "reason": {
      "type": "string"
    },
    "diff": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key"],
        "properties": {
          "key": {
            "type": "string"
          },
          "before": {},
          "after": {}
        },
        "additionalProperties": false
      }
    },
    "applied": {
      "type": "boolean"
    },
    "policy_id": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "policy_kind": {
      "type": "string",
      "enum": ["llm", "rules", "hybrid"]
    },
    "intuition_event_id": {
      "type": "string"
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "moderate", "high", "critical"]
    },
    "salience_signals": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["task_complexity", "normalization_gap", "policy_hint", "safety_boundary"]
      }
    },
    "strategy_hints": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["conservative", "verify_first", "retrieve_more", "narrow_scope"]
      }
    },
    "tool_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["no_side_effects", "read_only", "require_double_check"]
      }
    },
    "scrutiny_level": {
      "type": "string",
      "enum": ["normal", "elevated", "strict"]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "legacy_directive_id": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
