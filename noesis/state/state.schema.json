{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://noesis.ai/schema/state/1.0.0",
  "title": "Noēsis State v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "state_schema_version",
    "episode",
    "goal",
    "beliefs",
    "plan",
    "memory",
    "outcomes"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "state_schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "episode": { "$ref": "#/$defs/episode" },
    "goal": { "$ref": "#/$defs/goal" },
    "beliefs": {
      "type": "array",
      "items": { "$ref": "#/$defs/belief" }
    },
    "plan": { "$ref": "#/$defs/plan" },
    "memory": { "$ref": "#/$defs/memory" },
    "outcomes": { "$ref": "#/$defs/outcomes" },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "run_index"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "run_index": { "type": "integer", "minimum": 1 },
        "kind": { "type": "string" }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "events": { "type": "string" },
        "summary": { "type": "string" },
        "learn": { "type": "string" }
      }
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "$defs": {
    "id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "type": "string" },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "policy_id": { "type": "string" },
        "adapter_id": { "type": "string" }
      },
      "patternProperties": {
        "^x-": {}
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "uri"],
      "properties": {
        "type": { "type": "string" },
        "uri": { "type": "string" },
        "sha256": { "type": "string" }
      },
      "patternProperties": { "^x-": {} }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "seed", "started_at", "tags"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "seed": { "type": "integer" },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        },
        "using": { "type": "string" }
      },
      "patternProperties": { "^x-": {} }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "type"],
      "properties": {
        "task": { "type": "string" },
        "type": { "type": "string" },
        "context": { "type": ["string", "null"] }
      },
      "patternProperties": { "^x-": {} }
    },
    "belief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "confidence", "timestamp", "provenance"],
      "properties": {
        "statement": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "source", "updated_at"],
      "properties": {
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/planStep" }
        },
        "rationale": { "type": "string" },
        "source": { "type": "string" },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      },
      "patternProperties": { "^x-": {} }
    },
    "planStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "type": "string",
          "enum": ["detect", "analyze", "plan", "act", "verify", "review"]
        },
        "description": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["pending", "running", "done", "skipped", "failed", "vetoed"]
        },
        "rationale": { "type": "string" },
        "inputs": { "type": "object", "additionalProperties": true },
        "outputs": { "type": "object", "additionalProperties": true },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      },
      "patternProperties": { "^x-": {} }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts"],
      "properties": {
        "facts": {
          "type": "array",
          "items": { "$ref": "#/$defs/memoryFact" }
        },
        "scratchpad": { "type": "string" }
      },
      "patternProperties": { "^x-": {} }
    },
    "memoryFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key", "value"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["metric", "alert", "doc", "note", "signal"]
        },
        "key": { "type": "string" },
        "value": {},
        "provenance": { "$ref": "#/$defs/provenance" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "ttl_sec": { "type": "integer", "minimum": 0 }
      },
      "patternProperties": { "^x-": {} }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "actions"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ok", "error", "vetoed", "aborted", "partial", "pending"]
        },
        "summary": { "type": "string" },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        },
        "metrics": { "type": "object", "additionalProperties": true },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactRef" }
        }
      },
      "patternProperties": { "^x-": {} }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "tool",
        "input_excerpt",
        "result_status",
        "timestamp"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "type": "string" },
        "tool": { "type": "string" },
        "input_excerpt": { "type": "string" },
        "result_status": {
          "type": "string",
          "enum": ["ok", "error", "vetoed", "aborted", "partial", "pending"]
        },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "step_id": { "$ref": "#/$defs/id" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "result_artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactRef" }
        }
      },
      "patternProperties": { "^x-": {} }
    }
  }
}
